body {
    background-color: #1a1a2e;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    font-family: Arial, sans-serif;
}

#game-container {
    display: flex;
    gap: 20px;
}

.tube {
    width: 60px;
    height: 240px;
    border: 4px solid #555;
    border-top: none;
    border-radius: 0 0 30px 30px;
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    padding-bottom: 5px;
    cursor: pointer;
    background-color: rgba(255, 255, 255, 0.05);
}

.ball {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin-bottom: 2px;
}
